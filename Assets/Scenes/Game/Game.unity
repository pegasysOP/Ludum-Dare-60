      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[0].text
      value: '"You must be the auditor that Mr Hale mentioned. He''s tied up with the board at the moment, but he asked me to give you this."'
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[1].text
      value: She hands over a burned CD in a paper sleeve.
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[2].text
      value: '"It''s a copy of the Q3 financial report. Nothing dramatic as far as I know, just some figures don''t quite add up."'
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[3].text
      value: '"What sort of discrepancies?"'
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[4].text
      value: '"I''m not an accountant. I just remember Finance sending revisions back and forth for almost a week. The final numbers apparently don''t match the supporting data."'
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[5].text
      value: '"Anyone particular worried about it?"'
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[6].text
      value: '"The CEO was. That''s why you''re here, isn''t it?"'
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[0].characterName
      value: Secretary
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[2].characterName
      value: Secretaru
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[3].characterName
      value: '*Player*'
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
      propertyPath: dialogLinesWithCharacterInfo.Array.data[4].characterName
      value: Secretary
      objectReference: {fileID: 0}
    - target: {fileID: 1332593120877055998, guid: 51c262e2215000e4facbc3301b86c89e, type: 3}
