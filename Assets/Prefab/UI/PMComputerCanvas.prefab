  rowTemplate: {fileID: 864038427666061421}
  list: {fileID: 2465381862136208491}
  listView: {fileID: 4459111510947666086}
  emailView: {fileID: 8816072665083258025}
  subjectText: {fileID: 5365999296699662541}
  fromText: {fileID: 3067077948278361163}
  dateText: {fileID: 7084880504639589166}
  bodyText: {fileID: 2653259068496613625}
  backButton: {fileID: 2345684049438014560}
  emails:
  - from: "Social Committee"
    subject: "Team lunch this Thursday"
    date: "Tue, Aug 16, 2005, 10:12 AM"
    body: "Pizza in the big meeting room at 12:30.\n\nReply with your topping requests by Wednesday. Pineapple requests will be noted, and judged."
    read: 1
  - from: "Finance"
    subject: "Incident Report"
    date: "Friday 5th August 2005 at 8:45 PM"
    body: "The bug was present from the update on Friday 8th July 2005 until the update on Friday 5th August 2005.\n\nThe issue is now resolved."
    read: 0
  - from: "Office Manager"
    subject: "Kitchen fridge clear out"
    date: "Wed, Aug 3, 2005, 3:30 PM"
    body: "Anything left in the kitchen fridge after 4pm today will be thrown away.\n\nYes, that includes the yoghurt that has been there since spring."
    read: 1
  - from: "Office Manager"
    subject: "The new coffee machine is here"
    date: "Mon, Aug 1, 2005, 9:05 AM"
    body: "Please read the instructions taped to the side before pressing every button at once.\n\nThe old machine has been given a dignified send off."
    read: 1
  - from: "Productivity Weekly"
    subject: "10 ways to make meetings shorter"
    date: "Wed, Jul 27, 2005, 7:00 AM"
    body: "Tip 1: Have fewer meetings.\n\nTips 2 to 10 are available to premium subscribers.\n\nTo unsubscribe, reply with STOP."
    read: 1
