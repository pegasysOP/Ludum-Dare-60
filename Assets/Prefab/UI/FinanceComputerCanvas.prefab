  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DesktopMail
  rowTemplate: {fileID: 2878002575838319895}
  list: {fileID: 1852473405062205646}
  listView: {fileID: 7256084277050644068}
  emailView: {fileID: 3093913205323945450}
  subjectText: {fileID: 2192464985419328710}
  fromText: {fileID: 6712200579292810336}
  dateText: {fileID: 2225360398745030797}
  bodyText: {fileID: 2136243817804841606}
  backButton: {fileID: 8138104977915083244}
  emails:
  - from: "Office Manager"
    subject: "The office plants are back"
    date: "Mon, Aug 15, 2005, 9:40 AM"
    body: "The plants are back from the nursery and looking much happier.\n\nPlease water yours. The cactus does not count as low maintenance if you never look at it."
    read: 1
    sent: 0
    to: ""
  - from: "Social Committee"
    subject: "Bake off entries close Friday"
    date: "Thu, Aug 11, 2005, 2:15 PM"
    body: "Entries for the office bake off close this Friday.\n\nLast year's winner has been asked, politely, to make something other than lemon drizzle."
    read: 1
    sent: 0
    to: ""
  - from: "Facilities"
    subject: "Your new chair has arrived"
    date: "Tue, Aug 9, 2005, 11:20 AM"
    body: "The desk chair you asked for is waiting at the front desk.\n\nSome assembly required. Mostly the wheels."
    read: 1
    sent: 0
    to: ""
  - from: "Finance"
    subject: "Incident Report"
    date: "Friday 5th August 2005 at 8:45 PM"
    body: "The bug was present from the update on Friday 8th July 2005 until the update on Friday 5th August 2005.\n\nThe issue is now resolved."
    read: 1
    sent: 1
    to: "Greg Lawson"
  - from: "Spreadsheets Monthly"
    subject: "Pivot tables: a love story"
    date: "Thu, Jul 14, 2005, 7:00 AM"
    body: "This month: pivot tables, and why they deserve your love.\n\nAlso inside, the ten most beautiful bar charts of the year.\n\nTo unsubscribe, reply with STOP."
    read: 1
    sent: 0
    to: ""
