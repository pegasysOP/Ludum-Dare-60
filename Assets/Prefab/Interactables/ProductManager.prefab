MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4400354050955162370}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13207926ca803674293b6f9244e50057, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProductManagerInteractable
  dialogLinesWithCharacterInfo:
  - text: I assume you've already spoken to Finance.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: Why Finance?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: Because whenever numbers stop adding up, everyone immediately blames the product. Nobody ever considers the accountants.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: He lets out a tired laugh.
    character: {fileID: 0}
  - text: Although to be fair, the accountants say exactly the same thing about us.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: You've got an explanation for the discrepancies?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: I've got six explanations. Three involve software, two involve spreadsheets, and one involves setting fire to the building and starting over.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: It's been a long week.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: Anyway. Workstation's unlocked. Feel free.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: You seem fairly relaxed.
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: Relaxed isn't the word.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: Yesterday I sat through a two-hour meeting about whether a button should say 'Submit' or 'Confirm'.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: Nothing you find on that computer can hurt me more than that meeting did.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  repeatableLine:
    text: Honestly, at this point I'd settle for a boring explanation.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
