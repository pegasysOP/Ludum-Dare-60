MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4400354050955162370}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13207926ca803674293b6f9244e50057, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProductManagerInteractable
  countsAsEvidence: 0
  evidence: 0
  dialogLinesWithCharacterInfo:
  - text: You here about the discrepancy?
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: That's right.
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: Great. Add your name to the queue.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: I've been here three nights straight.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: We're moving everything over to network file transfers. *ugh*
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  - text: Mind if I take a look around?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: Go ahead. My PC's right here. Still has a CD player too, IT hasn't got around to replacing it yet.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
  repeatableLine:
    text: That CD drive is older than some of our interns.
    character: {fileID: 11400000, guid: bb430af671224a169c0320f2b32830f0, type: 2}
