  m_Name: 
  m_EditorClassIdentifier: '::'
  countsAsEvidence: 0
  evidence: 0
  dialogLinesWithCharacterInfo:
  - text: The CEO wanted you to have this CD.
    character: {fileID: 11400000, guid: 66288176f0d64d55a642533492dab6c6, type: 2}
  - text: What's on it?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: Q3 report. Burned it myself.
    character: {fileID: 11400000, guid: 66288176f0d64d55a642533492dab6c6, type: 2}
  - text: The CD, not the report.
    character: {fileID: 11400000, guid: 66288176f0d64d55a642533492dab6c6, type: 2}
  repeatableLine:
    text: If another exec says 'circle back', I'm gone.
    character: {fileID: 11400000, guid: 66288176f0d64d55a642533492dab6c6, type: 2}
  note:
    suspect: {fileID: 11400000, guid: 66288176f0d64d55a642533492dab6c6, type: 2}
    text: Burned the Q3 report CD herself. Fed up with the execs?
    lean: 0
  cdLineIndex: 2
