  m_Script: {fileID: 11500000, guid: 13207926ca803674293b6f9244e50057, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProductManagerInteractable
  countsAsEvidence: 0
  evidence: 0
  dialogLinesWithCharacterInfo:
  - text: Welcome, welcome!
    character: {fileID: 11400000, guid: c19b6085ea1f4aa38032526b613408ae, type: 2}
  - text: Please find out what's going on. Everyone keeps using words like 'root cause analysis.
    character: {fileID: 11400000, guid: c19b6085ea1f4aa38032526b613408ae, type: 2}
  - text: I suspect nobody knows what that means.
    character: {fileID: 11400000, guid: c19b6085ea1f4aa38032526b613408ae, type: 2}
  repeatableLine:
    text: If growing a beard improved profits, We'd be unstoppable.
    character: {fileID: 11400000, guid: c19b6085ea1f4aa38032526b613408ae, type: 2}
