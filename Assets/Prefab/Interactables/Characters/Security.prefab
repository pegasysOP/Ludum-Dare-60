--- !u!114 &5439513432788928827
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5277441522547421063}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13207926ca803674293b6f9244e50057, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProductManagerInteractable
  countsAsEvidence: 0
  evidence: 0
  dialogLinesWithCharacterInfo:
  - text: Look, whatever happened, it wasn't me.
    character: {fileID: 11400000, guid: 97526db448704d30b3e32ccec2baf8fb, type: 2}
  - text: Relax. I'm just investigating.
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: Oh. Good.
    character: {fileID: 11400000, guid: 97526db448704d30b3e32ccec2baf8fb, type: 2}
  - text: Do you keep archives?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: About a month, I think...
    character: {fileID: 11400000, guid: 97526db448704d30b3e32ccec2baf8fb, type: 2}
  - text: You can check the recordings yourself if you want.
    character: {fileID: 11400000, guid: 97526db448704d30b3e32ccec2baf8fb, type: 2}
  repeatableLine:
    text: Honestly, the cameras know more about this building than I do.
    character: {fileID: 11400000, guid: 97526db448704d30b3e32ccec2baf8fb, type: 2}
  note:
    suspect: {fileID: 11400000, guid: 97526db448704d30b3e32ccec2baf8fb, type: 2}
    text: Runs the camera archive.
    lean: 0
