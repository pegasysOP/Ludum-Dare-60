MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6072174960416334879}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13207926ca803674293b6f9244e50057, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProductManagerInteractable
  dialogLinesWithCharacterInfo:
  - text: I spent two weeks on a beach trying not to think about spreadsheets.
    character: {fileID: 11400000, guid: 0ef43d2e83704a55b083bf30c304b9a3, type: 2}
  - text: Did it work?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: No.
    character: {fileID: 11400000, guid: 0ef43d2e83704a55b083bf30c304b9a3, type: 2}
  - text: Maybe there's something on my computer that can help you.
    character: {fileID: 11400000, guid: 0ef43d2e83704a55b083bf30c304b9a3, type: 2}
  - text: Password?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: 'It was on a sticky note... '
    character: {fileID: 11400000, guid: 0ef43d2e83704a55b083bf30c304b9a3, type: 2}
  - text: 'Which, in hindsight, may have been a security risk. '
    character: {fileID: 11400000, guid: 0ef43d2e83704a55b083bf30c304b9a3, type: 2}
  repeatableLine:
    text: The password was definitely on a sticky note. Probably.
    character: {fileID: 11400000, guid: 0ef43d2e83704a55b083bf30c304b9a3, type: 2}
