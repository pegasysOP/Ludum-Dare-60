MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2815498257208665017}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13207926ca803674293b6f9244e50057, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProductManagerInteractable
  dialogLinesWithCharacterInfo:
  - text: I'm afraid I'm very busy with performance reviews right now.
    character: {fileID: 11400000, guid: 65181e84e9c64dcc8477f95d0e0d485f, type: 2}
  - text: Just a few questions.
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: Mom, if a hamster bites someone, does it get a performance review?
    character: {fileID: 11400000, guid: 3db87619b2f614e45b2d205329aa6892, type: 2}
  - text: We're not having this conversation again.
    character: {fileID: 11400000, guid: 65181e84e9c64dcc8477f95d0e0d485f, type: 2}
  - text: So that's a maybe?
    character: {fileID: 11400000, guid: 3db87619b2f614e45b2d205329aa6892, type: 2}
  - text: Please excuse me.
    character: {fileID: 11400000, guid: 65181e84e9c64dcc8477f95d0e0d485f, type: 2}
  repeatableLine:
    text: I'm very busy.
    character: {fileID: 11400000, guid: 65181e84e9c64dcc8477f95d0e0d485f, type: 2}
