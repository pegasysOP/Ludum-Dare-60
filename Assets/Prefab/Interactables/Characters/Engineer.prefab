--- !u!114 &8143242966682691316
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 65943902086694740}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13207926ca803674293b6f9244e50057, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProductManagerInteractable
  countsAsEvidence: 0
  evidence: 0
  dialogLinesWithCharacterInfo:
  - text: I'm afraid I'm probably not going to be much help.
    character: {fileID: 11400000, guid: cc20f72f74b140d2bfee77910408b697, type: 2}
  - text: Why's that?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: Because we fixed the bug a month ago.
    character: {fileID: 11400000, guid: cc20f72f74b140d2bfee77910408b697, type: 2}
  - text: You're sure?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: As sure as a software engineer ever is.
    character: {fileID: 11400000, guid: cc20f72f74b140d2bfee77910408b697, type: 2}
  - text: Meaning?
    character: {fileID: 11400000, guid: 84e4cd08ba834598bbef8b33274bcd0c, type: 2}
  - text: About ninety-eight percent sure. Which is basically certainty in our industry.
    character: {fileID: 11400000, guid: cc20f72f74b140d2bfee77910408b697, type: 2}
  repeatableLine:
    text: I fixed the bug. That's usually where my stories end.
    character: {fileID: 11400000, guid: cc20f72f74b140d2bfee77910408b697, type: 2}
